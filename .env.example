# Copy to .env.local. Never commit real values. Devnet only.

# --- AI ---
# gemini (default) or anthropic
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Optional provider
ANTHROPIC_API_KEY=
# Model ids. If the orchestrator fails the evals with Flash-Lite, raise only AI_MODEL to gemini-3.6-flash.
AI_MODEL=gemini-3.5-flash-lite
EXTRACTION_MODEL=gemini-3.5-flash-lite
# Live model calls per UTC day; once reached the app serves recordings (per warm instance on serverless).
AI_DAILY_CALL_CAP=300
# 1 = serve recorded responses for the 3 demo tenants (no API calls)
REPLAY=0

# --- Session (Phase 0-1) ---
# Random string, 32+ chars. Signs the client-held session blob (HMAC-SHA256).
SESSION_SECRET=

# --- Solana (devnet only) ---
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet
# custodial = platform custody wallet + Memo; program = Anchor rental_escrow (Phase 3+)
ESCROW_MODE=custodial
# tUSDC test mint (6 decimals), written by scripts/setup-devnet.ts
PAYMENT_MINT=
# Server-side demo keypairs as JSON arrays of the 64-byte secret key, written by scripts/setup-devnet.ts.
# The platform wallet is the custody wallet and the fee payer of every transaction.
PLATFORM_SECRET_KEY=
LANDLORD_SECRET_KEY=
# Also signs the simulated 2-of-3 deposit release in the agency panel (/agency); without it release is disabled.
AGENCY_SECRET_KEY=
TENANT_ANA_SECRET_KEY=
TENANT_BRUNO_SECRET_KEY=
TENANT_CARLA_SECRET_KEY=
# Anchor program id (Phase 3+)
PROGRAM_ID=

# --- Public ---
NEXT_PUBLIC_EXPLORER_URL=https://explorer.solana.com
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# Public URL of the app (lib/config/brand.ts)
NEXT_PUBLIC_APP_URL=
